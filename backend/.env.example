# AI-Powered Career Coach - Backend Configuration

# Server Port
PORT=5000

# Client Application URL for CORS
CLIENT_URL=http://localhost:5173

# MongoDB Connection String
# Leave empty or omit to automatically use the built-in development in-memory MongoDB
MONGODB_URI=

# JWT Secret for User Authentication
JWT_SECRET=ai_career_coach_super_secure_jwt_secret_key_2025!

# Google Gemini API Key
# Provide your Google Gemini API key to enable live Gemini AI models
# If omitted or invalid, the backend will safely fall back to heuristic AI engine
GEMINI_API_KEY=

# Node Environment
NODE_ENV=development
